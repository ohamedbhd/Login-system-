void Calculator ()
{
    double num1, num2;
    char op;

    cout <<"   ■■■■■■■■■■■■■■■ slot calculator ■■■■■■■■■■■■■■■\n\n" ;

    cout << "enter Number ( 1 ): ";
    cin >> num1;

    cout << "enter your [ + , - , * , / ]: ";
    cin >> op;

    cout << "enter Number ( 2 ): ";
    cin >> num2;

    Design();

    switch (op)
    {
    case '+' :
        cout << num1 << " + " << num2<<" = "<< num1 + num2 << endl;
        break;
    case '-' :
        cout << num1 << " - " << num2 << " = " << num1 - num2 << endl ;
        break;

    case '*' :
        cout << num1 << " * " << num2 << " = " << num1 * num2 << endl ;
        break;

    case '/' :
        if (num2 ==0)
        {
            cout << "The number you entered is not divisible by zero\n";
        }
        else
        {
            cout << num1 << " / " << num2 << " = " << num1 / num2 << endl ;
        }
        break;
    default:
        cout <<"Eerro";
    }

}

